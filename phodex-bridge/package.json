{
  "name": "remodex",
  "version": "4.0.14",
  "releaseRepository": "mitu810/remodex",
  "description": "Local bridge between Codex and the Remodex mobile app. Run `remodex up` to start.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitu810/remodex.git",
    "directory": "phodex-bridge"
  },
  "homepage": "https://github.com/mitu810/remodex#readme",
  "bugs": {
    "url": "https://github.com/mitu810/remodex/issues"
  },
  "main": "src/index.js",
  "bin": {
    "remodex": "bin/remodex.js",
    "remodex-jsonl-diagnose": "bin/remodex-jsonl-diagnose.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node ./bin/remodex.js up",
    "test": "node --test ./test/*.test.js",
    "postinstall": "node ./src/bootstrap-codex-cli.js",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "keywords": [
    "remodex",
    "codex",
    "bridge",
    "cli"
  ],
  "author": "Emanuele Di Pietro",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.8.0"
  }
}
